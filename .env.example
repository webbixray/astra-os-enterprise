APP_NAME=Astra OS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AstraOSBot
TELEGRAM_WEBHOOK_URL=

# Webhooks
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5

# ============================================================================
# Database Configuration
# ============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=astraos
DB_USERNAME=astraos
DB_PASSWORD=secret

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================================
# Session & Cache
# ============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# ============================================================================
# Mail Configuration
# ============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@astraos.io"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# AI Provider Configuration
# ============================================================================
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-sonnet
ANTHROPIC_TIMEOUT=30

GOOGLE_AI_ENABLED=false
GOOGLE_AI_API_KEY=
GOOGLE_AI_DEFAULT_MODEL=gemini-pro
GOOGLE_AI_TIMEOUT=30

# AI Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=60
AI_TOKEN_LIMIT_PER_MINUTE=100000

# ============================================================================
# Agent Configuration
# ============================================================================
AGENT_DEFAULT_PROVIDER=openai
AGENT_DEFAULT_MODEL=gpt-4o-mini
AGENT_TASK_MAX_RETRIES=3
AGENT_TASK_TIMEOUT=30
AGENT_TASK_BATCH_SIZE=10

# ============================================================================
# Astra OS Feature Flags
# ============================================================================
ASTRA_OS_NAME="Astra OS"
ASTRA_OS_VERSION=1.0.0
ASTRA_OS_CURRENCY=USD
ASTRA_OS_TIMEZONE=UTC
ASTRA_OS_PER_PAGE=15
ASTRA_OS_MAX_PER_PAGE=100

ASTRA_FEATURE_CAMPAIGNS=true
ASTRA_FEATURE_AGENTS=true
ASTRA_FEATURE_WORKFLOWS=true
ASTRA_FEATURE_SOCIAL=true
ASTRA_FEATURE_ANALYTICS=true

ASTRA_SHADOW_MODE=false
ASTRA_SHADOW_OVERRIDE=false

# ============================================================================
# Campaign Configuration
# ============================================================================
CAMPAIGN_MIN_DAILY_BUDGET=5
CAMPAIGN_MAX_DAILY_BUDGET=100000
CAMPAIGN_MIN_TOTAL_BUDGET=50
CAMPAIGN_MAX_TOTAL_BUDGET=10000000
CAMPAIGN_DEFAULT_DAILY_BUDGET=100
CAMPAIGN_DEFAULT_CURRENCY=USD
CAMPAIGN_MIN_DURATION=1
CAMPAIGN_MAX_DURATION=365
CAMPAIGN_DEFAULT_DURATION=30
CAMPAIGN_DEFAULT_OBJECTIVE=conversions
CAMPAIGN_REQUIRE_APPROVAL=true
CAMPAIGN_AUTO_DISTRIBUTE=false

# ============================================================================
# Social Media Configuration
# ============================================================================
ASTRA_SOCIAL_AUTO_PUBLISH=true
ASTRA_SOCIAL_AUTO_REPLY=false

# ============================================================================
# Platform API Configuration
# ============================================================================
META_API_ENDPOINT=https://graph.facebook.com/v19.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

GOOGLE_ADS_ENDPOINT=https://googleads.googleapis.com/v16
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

LINKEDIN_API_ENDPOINT=https://api.linkedin.com/v2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

TIKTOK_API_ENDPOINT=https://business-api.tiktok.com/open_api/v1.3
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ============================================================================
# Audit & Monitoring
# ============================================================================
ASTRA_AUDIT_LOGGING=true
ASTRA_AUDIT_RETENTION=90
ASTRA_ANALYTICS_RETENTION=365
ASTRA_ANALYTICS_AUTO_REPORTS=true

# ============================================================================
# Observability (Prometheus, OpenTelemetry, Sentry)
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=metrics
PROMETHEUS_AUTH_ENABLED=true
PROMETHEUS_NAMESPACE=astra_os

OTEL_ENABLED=false
OTEL_SERVICE_NAME=astra-os
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ============================================================================
# SSO Configuration
# ============================================================================
SSO_ENABLED=false
SSO_PASSPORT_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT=
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=
SSO_GITHUB_REDIRECT=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_REDIRECT=
SSO_SAML_CLIENT_ID=
SSO_SAML_CLIENT_SECRET=
SSO_SAML_REDIRECT=

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_PASSWORD=
BACKUP_ENCRYPTION=AES-256-CBC
BACKUP_COMPRESSION=gzip
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_YEARLY=2
BACKUP_MAX_STORAGE_MB=10000
BACKUP_SLACK_WEBHOOK=
BACKUP_SLACK_CHANNEL=#backups
BACKUP_SLACK_USERNAME=Astra OS Backup
BACKUP_MAIL_TO=

# ============================================================================
# Octane (High Performance)
# ============================================================================
OCTANE_ENABLED=false
OCTANE_SERVER=swoole
OCTANE_WORKERS=auto

# ============================================================================
# Workflow Configuration
# ============================================================================
ASTRA_WORKFLOW_CUSTOM_NODES=false
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_DELAY=30
WORKFLOW_MAX_EXECUTION_TIME=86400

# ============================================================================
# Vite
# ============================================================================
VITE_APP_NAME="${APP_NAME}"
